<aside class="wishlist-drawer" id="wishlistDrawer" aria-labelledby="wishlistTitle"><div class="cart-drawer__header"><h2 class="cart-drawer__title" id="wishlistTitle">{% if locale == 'en' %}Saved pieces{% else %}Gemerkte Stücke{% endif %}</h2><button class="cart-drawer__close" id="wishlistClose" aria-label="{% if locale == 'en' %}Close saved pieces{% else %}Merkliste schließen{% endif %}">×</button></div><div class="cart-drawer__body"><div class="cart-drawer__empty" id="wishlistEmptyState"><p>{% if locale == 'en' %}Nothing saved yet.{% else %}Noch keine Stücke gemerkt.{% endif %}</p><a href="{{ localePrefix | default('') }}/collection/" class="btn btn--primary">{% if locale == 'en' %}Explore the collection{% else %}Kollektion entdecken{% endif %}</a></div><div id="wishlistItems"></div></div></aside>
