<article class="product-card animate-on-scroll" data-id="{{ product.id }}" data-product-id="{{ product.id }}" data-category="{{ product.category }}" data-price="{{ product.price }}"><a href="{{ localePrefix }}{{ product.url }}" class="product-card__link"><div class="product-card__image"><img src="{{ product.image }}" alt="{% if locale == 'en' %}{{ product.altEn }}{% else %}{{ product.alt }}{% endif %}" loading="lazy" width="1086" height="1448">{% if product.hoverImage and product.hoverImage != product.image %}<img src="{{ product.hoverImage }}" alt="{% if locale == 'en' %}{{ product.hoverAltEn }}{% else %}{{ product.hoverAlt }}{% endif %}" class="product-card__hover-img" loading="lazy">{% endif %}</div><div class="product-card__info"><h3 class="product-card__name">{% if locale == 'en' %}{{ product.nameEn }}{% else %}{{ product.name }}{% endif %}</h3><p class="product-card__price">€{{ product.price }},00 <small class="product-card__tax">{% if locale == 'en' %}incl. VAT{% else %}inkl. MwSt.{% endif %}</small></p><p class="product-card__shipping">{% if locale == 'en' %}plus shipping{% else %}zzgl. Versandkosten{% endif %}</p><div class="product-card__colors">{% for color in product.colorOptions %}<span class="product-card__color-dot product-card__color-dot--{{ color.token }}" title="{% if locale == 'en' %}{{ color.labelEn }}{% else %}{{ color.label }}{% endif %}"></span>{% endfor %}</div></div></a><button class="product-card__wishlist" data-product-id="{{ product.id }}" aria-pressed="false" aria-label="{% if locale == 'en' %}Save {{ product.nameEn }}{% else %}{{ product.name }} merken{% endif %}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg></button></article>