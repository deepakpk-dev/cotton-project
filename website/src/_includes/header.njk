<div class="announcement-bar" id="announcementBar"><span>{% if locale == 'en' %}Free DHL delivery in Germany from €75{% else %}Kostenloser DHL-Versand in Deutschland ab 75 €{% endif %}</span><button class="announcement-bar__close" aria-label="{% if locale == 'en' %}Dismiss{% else %}Schließen{% endif %}" type="button">×</button></div>
<header class="header" id="header">
  <div class="header__inner">
    <nav class="header__nav" aria-label="{% if locale == 'en' %}Primary navigation{% else %}Hauptnavigation{% endif %}">
      <a href="{{ localePrefix | default('') }}/collection/" class="header__nav-link">{% if locale == 'en' %}Collection{% else %}Kollektion{% endif %}</a>
      <a href="{{ localePrefix | default('') }}/materials/" class="header__nav-link">{% if locale == 'en' %}Materials{% else %}Materialien{% endif %}</a>
      <a href="{{ localePrefix | default('') }}/collection/#lookbook" class="header__nav-link">Lookbook</a>
      <a href="{{ localePrefix | default('') }}/brand-story/" class="header__nav-link">{% if locale == 'en' %}About{% else %}Über uns{% endif %}</a>
    </nav>
    <div class="header__logo"><a href="{{ localePrefix | default('') }}/">TARA</a></div>
    <div class="header__actions">
      <div class="header__lang-toggle"><a href="/" {% if locale != 'en' %}aria-current="page"{% endif %}>DE</a><span aria-hidden="true">|</span><a href="/en/" {% if locale == 'en' %}aria-current="page"{% endif %}>EN</a></div>
      <button class="header__action-btn" id="searchToggle" aria-controls="searchOverlay" aria-expanded="false" aria-label="{% if locale == 'en' %}Search{% else %}Suchen{% endif %}">⌕</button>
      <button class="header__action-btn" id="wishlistToggle" aria-controls="wishlistDrawer" aria-expanded="false" aria-label="{% if locale == 'en' %}Saved pieces{% else %}Gemerkte Stücke{% endif %}">♡</button>
      <button class="header__bag-btn" id="cartToggle" aria-controls="cartDrawer" aria-expanded="false" aria-label="{% if locale == 'en' %}Shopping bag{% else %}Warenkorb{% endif %}">
        <svg class="header__bag-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 8.5h14l-1 11H6l-1-11Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/></svg><span class="header__bag-label">{% if locale == 'en' %}Bag{% else %}Warenkorb{% endif %}</span><span class="header__cart-count">0</span>
      </button>
      <button class="header__action-btn header__account-btn" id="accountToggle" aria-controls="accountDialog" aria-expanded="false" aria-label="{% if locale == 'en' %}Account information{% else %}Kontoinformationen{% endif %}"><svg class="header__account-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg></button>
    </div>
  </div>
</header>
