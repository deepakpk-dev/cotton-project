<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div><p class="footer__brand-name">TARA</p><p class="footer__brand-text">{% if locale == 'en' %}An accessible-premium cotton brand concept, designed as a frontend portfolio prototype.{% else %}Ein Konzept für eine zugängliche Premium-Baumwollmarke, gestaltet als Frontend-Portfolio-Prototyp.{% endif %}</p></div>
      <div><h2 class="footer__heading">Shop</h2><div class="footer__links"><a href="{{ localePrefix | default('') }}/collection/">{% if locale == 'en' %}Collection{% else %}Kollektion{% endif %}</a><a href="{{ localePrefix | default('') }}/collection/?category=Kleider">{% if locale == 'en' %}Dresses{% else %}Kleider{% endif %}</a><a href="{{ localePrefix | default('') }}/collection/?category=Hosen">{% if locale == 'en' %}Trousers{% else %}Hosen{% endif %}</a></div></div>
      <div><h2 class="footer__heading">{% if locale == 'en' %}About{% else %}Über TARA{% endif %}</h2><div class="footer__links"><a href="{{ localePrefix | default('') }}/brand-story/">{% if locale == 'en' %}Brand concept{% else %}Markenkonzept{% endif %}</a><a href="{{ localePrefix | default('') }}/materials/">{% if locale == 'en' %}Materials approach{% else %}Materialansatz{% endif %}</a><a href="{{ localePrefix | default('') }}/size-guide/">{% if locale == 'en' %}Size guide{% else %}Größenberatung{% endif %}</a></div></div>
      <div><h2 class="footer__heading">{% if locale == 'en' %}Prototype notice{% else %}Prototyp-Hinweis{% endif %}</h2><p>{% if locale == 'en' %}No orders, payments, subscriptions or support requests are processed here.{% else %}Hier werden keine Bestellungen, Zahlungen, Abonnements oder Supportanfragen verarbeitet.{% endif %}</p></div>
    </div>
    <p class="footer__trust-line">{% if locale == 'en' %}Planned for a live store: DHL delivery in Germany, free returns, Klarna, PayPal, SEPA and cards.{% else %}Für einen Live-Shop geplant: DHL-Versand in Deutschland, kostenlose Rückgabe, Klarna, PayPal, SEPA und Karten.{% endif %}</p>
    <div class="footer__bottom"><div class="footer__copyright footer__legal-links">© 2026 TARA · {% if locale == 'en' %}Fictional portfolio prototype{% else %}Fiktiver Portfolio-Prototyp{% endif %}<br><a href="/legal/impressum/">Impressum</a> · <a href="/legal/datenschutz/">Datenschutz</a> · <a href="/legal/agb/">AGB</a> · <a href="/legal/widerruf/">{% if locale == 'en' %}Withdrawal information{% else %}Widerrufsbelehrung{% endif %}</a> · <a href="#" id="cookieSettingsLink">{% if locale == 'en' %}Cookie settings{% else %}Cookie-Einstellungen{% endif %}</a></div></div>
  </div>
</footer>
