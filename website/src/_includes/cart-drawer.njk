<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-labelledby="cartTitle"><div class="cart-drawer__header"><h2 class="cart-drawer__title" id="cartTitle">{% if locale == 'en' %}Shopping bag{% else %}Warenkorb{% endif %}</h2><button class="cart-drawer__close" id="cartClose" aria-label="{% if locale == 'en' %}Close bag{% else %}Warenkorb schließen{% endif %}">×</button></div><div class="cart-drawer__body"><div class="cart-drawer__empty" id="cartEmptyState"><p>{% if locale == 'en' %}Your bag is empty.{% else %}Ihr Warenkorb ist leer.{% endif %}</p><a href="{{ localePrefix | default('') }}/collection/" class="btn btn--primary">{% if locale == 'en' %}Explore the collection{% else %}Kollektion entdecken{% endif %}</a></div><div class="cart-drawer__items" id="cartItems" hidden></div></div><div class="cart-drawer__footer"><p>{% if locale == 'en' %}Planned DHL shipping is free from €75 in Germany.{% else %}Geplanter DHL-Versand ist ab 75 € in Deutschland kostenlos.{% endif %}</p><div class="cart-drawer__total"><span>{% if locale == 'en' %}Subtotal{% else %}Zwischensumme{% endif %}</span><span id="cartSubtotal">€0,00</span></div><button class="btn btn--dark btn--full" type="button" id="checkoutButton" disabled>{% if locale == 'en' %}Continue to demo checkout{% else %}Zum Demo-Checkout{% endif %}</button><p class="cart-drawer__legal-note">{% if locale == 'en' %}Incl. VAT. No payment or order is created.{% else %}Inkl. MwSt. Es wird keine Zahlung oder Bestellung erstellt.{% endif %}</p></div></aside>
