<div class="size-table-wrap" tabindex="0" role="region" aria-label="{% if locale == 'en' %}Body measurement chart{% else %}Körpermaßtabelle{% endif %}"><table class="size-table"><caption>{% if locale == 'en' %}Illustrative body measurements in cm, not garment measurements. DE and EU sizes are identical here.{% else %}Illustrative Körpermaße in cm, keine Kleidungsmaße. DE- und EU-Größen sind hier identisch.{% endif %}</caption><thead><tr><th scope="col">DE / EU</th><th scope="col">{% if locale == 'en' %}Bust{% else %}Brust{% endif %}</th><th scope="col">{% if locale == 'en' %}Waist{% else %}Taille{% endif %}</th><th scope="col">{% if locale == 'en' %}Hips{% else %}Hüfte{% endif %}</th></tr></thead><tbody>{% for row in sizing %}<tr><th scope="row">{{ row.size }}</th><td>{{ row.bust }}</td><td>{{ row.waist }}</td><td>{{ row.hips }}</td></tr>{% endfor %}</tbody></table></div>