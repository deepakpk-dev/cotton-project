<section class="search-overlay" id="searchOverlay" aria-labelledby="searchTitle"><div class="search-overlay__inner"><div class="cart-drawer__header"><h2 id="searchTitle">{% if locale == 'en' %}Search the collection{% else %}Kollektion durchsuchen{% endif %}</h2><button type="button" class="search-overlay__close" id="searchClose" aria-label="{% if locale == 'en' %}Close search{% else %}Suche schließen{% endif %}">×</button></div><form class="search-overlay__form"><label for="searchInput" class="sr-only">{% if locale == 'en' %}Search by name, category or material{% else %}Nach Name, Kategorie oder Material suchen{% endif %}</label><input type="search" class="search-overlay__input" id="searchInput" autocomplete="off" placeholder="{% if locale == 'en' %}Search pieces{% else %}Stücke suchen{% endif %}"><button type="submit" class="btn btn--primary">{% if locale == 'en' %}Search{% else %}Suchen{% endif %}</button></form><div id="searchResults" role="status" aria-live="polite"></div></div></section>
